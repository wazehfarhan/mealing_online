<?xml version="1.0"?>
<psalm
    errorLevel="5"
>
    <projectFiles>
        <directory name="." />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="node_modules" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <MissingParamType errorLevel="suppress" />
        <MissingPropertyType errorLevel="suppress" />
        <MissingDocblockType errorLevel="suppress" />
    </issueHandlers>
</psalm>
